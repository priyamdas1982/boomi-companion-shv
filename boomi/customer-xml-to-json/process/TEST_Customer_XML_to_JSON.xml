<?xml version="1.0" encoding="UTF-8"?>
<bns:Component xmlns:bns="http://api.platform.boomi.com/"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               componentId=""
               folderId="{{FOLDER_ID}}"
               name="TEST Customer XML to JSON"
               type="process">
  <bns:encryptedValues/>
  <bns:description>Test harness: feeds sample Customers XML into "Customer XML to JSON" and logs the JSON result.</bns:description>
  <bns:object>
    <process allowSimultaneous="false" enableUserLog="false" processLogOnErrorOnly="false" purgeDataImmediately="false" stopProcessingIfZeroDocuments="true" updateRunDates="true" workload="general">
      <shapes>
        <shape image="start" name="shape1" shapetype="start" userlabel="" x="48.0" y="46.0">
          <configuration>
            <noaction/>
          </configuration>
          <dragpoints>
            <dragpoint name="shape1.dragpoint1" toShape="shape2" x="224.0" y="56.0"/>
          </dragpoints>
        </shape>
        <shape image="message_icon" name="shape2" shapetype="message" userlabel="Sample Customers XML" x="240.0" y="48.0">
          <configuration>
            <message combined="false">
              <msgTxt>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;Customers&gt;
  &lt;Customer&gt;
    &lt;CustomerID&gt;C1001&lt;/CustomerID&gt;
    &lt;CustomerName&gt;Jane Smith&lt;/CustomerName&gt;
    &lt;PhoneNumber&gt;+1-555-0100&lt;/PhoneNumber&gt;
  &lt;/Customer&gt;
  &lt;Customer&gt;
    &lt;CustomerID&gt;C1002&lt;/CustomerID&gt;
    &lt;CustomerName&gt;Rahul Mehta&lt;/CustomerName&gt;
    &lt;PhoneNumber&gt;+91-98765-43210&lt;/PhoneNumber&gt;
  &lt;/Customer&gt;
&lt;/Customers&gt;</msgTxt>
              <msgParameters/>
            </message>
          </configuration>
          <dragpoints>
            <dragpoint name="shape2.dragpoint1" toShape="shape3" x="449.0" y="56.0"/>
          </dragpoints>
        </shape>
        <shape image="processcall_icon" name="shape3" shapetype="processcall" userlabel="Customer XML to JSON" x="465.0" y="48.0">
          <configuration>
            <processcall abort="true" processId="{{PROCESS_ID}}" wait="true">
              <parameters/>
              <returnpaths>
                <returnpaths childShapeName="shape3"/>
              </returnpaths>
            </processcall>
          </configuration>
          <dragpoints>
            <dragpoint identifier="shape3" name="shape3.dragpoint1" text="Customer JSON" toShape="shape4" x="674.0" y="56.0"/>
          </dragpoints>
        </shape>
        <shape image="notify_icon" name="shape4" shapetype="notify" userlabel="Log JSON output" x="690.0" y="48.0">
          <configuration>
            <notify disableEvent="true" enableUserLog="false" perExecution="false" title="">
              <notifyMessage>Customer JSON: {1}</notifyMessage>
              <notifyMessageLevel>INFO</notifyMessageLevel>
              <notifyParameters>
                <parametervalue key="0" valueType="current"/>
              </notifyParameters>
            </notify>
          </configuration>
          <dragpoints>
            <dragpoint name="shape4.dragpoint1" toShape="shape5" x="899.0" y="56.0"/>
          </dragpoints>
        </shape>
        <shape image="stop_icon" name="shape5" shapetype="stop" x="915.0" y="48.0">
          <configuration>
            <stop continue="true"/>
          </configuration>
          <dragpoints/>
        </shape>
      </shapes>
    </process>
  </bns:object>
  <bns:processOverrides/>
</bns:Component>
