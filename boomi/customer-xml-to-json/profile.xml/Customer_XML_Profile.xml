<?xml version="1.0" encoding="UTF-8"?>
<bns:Component xmlns:bns="http://api.platform.boomi.com/"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               componentId=""
               name="Customer XML Profile"
               type="profile.xml"
               folderId="{{FOLDER_ID}}">
  <bns:encryptedValues/>
  <bns:description>Source: list of customers with ID, name and phone number.</bns:description>
  <bns:object>
    <XMLProfile modelVersion="2" strict="true">
      <ProfileProperties>
        <XMLGeneralInfo/>
        <XMLOptions encoding="utf8" implicitElementOrdering="true" parseRespectMaxOccurs="true">
          <XMLFlavor><CustomStandardFlavor/></XMLFlavor>
        </XMLOptions>
      </ProfileProperties>
      <DataElements>
        <XMLElement dataType="character" isMappable="false" isNode="true" key="1" maxOccurs="1" minOccurs="1" name="Customers" useNamespace="-1">
          <DataFormat>
            <ProfileCharacterFormat/>
          </DataFormat>
          <XMLElement dataType="character" isMappable="false" isNode="true" key="2" maxOccurs="-1" minOccurs="0" name="Customer" useNamespace="-1">
            <DataFormat>
              <ProfileCharacterFormat/>
            </DataFormat>
            <XMLElement dataType="character" isMappable="true" isNode="true" key="3" maxOccurs="1" minOccurs="0" name="CustomerID" useNamespace="-1">
              <DataFormat>
                <ProfileCharacterFormat/>
              </DataFormat>
            </XMLElement>
            <XMLElement dataType="character" isMappable="true" isNode="true" key="4" maxOccurs="1" minOccurs="0" name="CustomerName" useNamespace="-1">
              <DataFormat>
                <ProfileCharacterFormat/>
              </DataFormat>
            </XMLElement>
            <XMLElement dataType="character" isMappable="true" isNode="true" key="5" maxOccurs="1" minOccurs="0" name="PhoneNumber" useNamespace="-1">
              <DataFormat>
                <ProfileCharacterFormat/>
              </DataFormat>
            </XMLElement>
          </XMLElement>
        </XMLElement>
      </DataElements>
      <Namespaces/>
    </XMLProfile>
  </bns:object>
</bns:Component>
