<?xml version="1.0" encoding="UTF-8"?>
<bns:Component xmlns:bns="http://api.platform.boomi.com/"
               componentId=""
               folderId="{{FOLDER_ID}}"
               name="SC-GB-CG-002 Customer JSON to XML Map"
               type="transform.map">
  <bns:object>
    <Map fromProfile="{{JSON_PROFILE_ID}}" toProfile="{{XML_PROFILE_ID}}">
      <Mappings>
        <!-- customers[]/customerId   -> Customers/Customer/CustomerID -->
        <Mapping fromKey="7" fromType="profile" toKey="3" toType="profile"/>
        <!-- customers[]/customerName -> Customers/Customer/CustomerName -->
        <Mapping fromKey="8" fromType="profile" toKey="4" toType="profile"/>
        <!-- customers[]/phoneNumber  -> Customers/Customer/PhoneNumber -->
        <Mapping fromKey="9" fromType="profile" toKey="5" toType="profile"/>
        <!-- customers[]/city         -> Customers/Customer/City -->
        <Mapping fromKey="10" fromType="profile" toKey="6" toType="profile"/>
      </Mappings>
      <Functions/>
      <Defaults/>
      <DocumentCacheJoins/>
    </Map>
  </bns:object>
</bns:Component>
